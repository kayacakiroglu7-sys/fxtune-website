{
  "name": "fxtune-website",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "deploy": "npm run build && npx vercel --prod",
    "deploy:staging": "npm run build && npx vercel",
    "deploy:netlify": "npm run build && npx netlify deploy --prod --dir=dist",
    "deploy:cloudflare": "npm run build && npx wrangler pages deploy dist --project-name=fxtune"
  },
  "dependencies": {
    "@astrojs/mdx": "^3.1.0",
    "@astrojs/sitemap": "3.5.1",
    "@astrojs/tailwind": "^5.1.0",
    "astro": "^4.16.0",
    "sharp": "^0.33.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.12.0",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
