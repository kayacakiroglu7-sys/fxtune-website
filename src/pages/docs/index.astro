---
import DocsLayout from '../../layouts/DocsLayout.astro'

const docCategories = [
  {
    category: 'Quick Start',
    icon: '🚀',
    docs: [
      {
        title: 'Getting Started',
        slug: 'getting-started',
        summary: 'Prerequisites, quick links, and the three pillars of the FxTune system.',
        badge: 'Essential',
      },
    ],
  },
  {
    category: 'Architecture',
    icon: '🏗️',
    docs: [
      {
        title: 'Architecture Overview',
        slug: 'architecture-overview',
        summary: 'Component topology and data flow across the Android native engine and UI.',
        badge: null,
      },
      {
        title: 'Master Blueprint',
        slug: 'master-blueprint',
        summary: 'Complete engineering specification: audio processing, workflow, and implementation status.',
        badge: 'Technical',
      },
    ],
  },
  {
    category: 'AI & Neural',
    icon: '🧠',
    docs: [
      {
        title: 'GhostHand AI',
        slug: 'ghosthand-ai',
        summary: 'The AI assistant system prompt, response scheme, and behavioral rules.',
        badge: 'AI',
      },
      {
        title: 'GhostHand Training',
        slug: 'ghosthand-training',
        summary: 'Training and optimization prompts for the neural audio coach.',
        badge: 'Advanced',
      },
    ],
  },
  {
    category: 'DSP & Audio',
    icon: '🎵',
    docs: [
      {
        title: 'Phase Vocoder',
        slug: 'phase-vocoder',
        summary: 'Pitch-preserving BPM-sync integration runbook for the DSP engine.',
        badge: null,
      },
      {
        title: 'C++ Performance',
        slug: 'cpp-performance',
        summary: 'DSP engine internals, NEON SIMD kernels, and latency benchmarks.',
        badge: 'Performance',
      },
    ],
  },
  {
    category: 'Brand & Design',
    icon: '🎨',
    docs: [
      {
        title: 'Brand Guidelines',
        slug: 'brand-guidelines',
        summary: 'Colors, typography, and messaging guardrails for the FxTune brand.',
        badge: 'Design',
      },
    ],
  },
]


---

<DocsLayout title="FxTune Docs - Overview">
  <div class="prose">
    <div class="flex items-center justify-between">
      <div>
        <h1>Documentation</h1>
        <p class="text-fxtxt/60">
          Everything you need to understand the FxTune platform — the C++ native audio engine, the
          Jetpack Compose UI, and the GhostHand AI assistant.
        </p>
      </div>
    </div>

    <div class="mt-6">
      <div class="relative">
        <input
          type="text"
          id="doc-search"
          placeholder="Search documentation..."
          class="w-full rounded-xl border border-fxcyan/20 bg-fxcard/50 px-4 py-3 pl-10 text-fxtxt placeholder:text-fxtxt/30 focus:border-fxcyan/50 focus:outline-none focus:ring-2 focus:ring-fxcyan/20"
        />
        <svg class="absolute left-3 top-3.5 h-4 w-4 text-fxtxt/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>

    {docCategories.map((category) => (
      <div class="mt-10">
        <h2 class="flex items-center gap-2 text-lg font-semibold text-fxtxt">
          <span>{category.icon}</span>
          {category.category}
        </h2>
        <div class="grid md:grid-cols-2 gap-4 mt-4">
          {category.docs.map((doc) => (
            <a
              href={`/docs/${doc.slug}/`}
              class="doc-card glass-panel p-5 hover:border-fxcyan/30 hover:bg-fxcyan/5 transition-all duration-200 group"
              data-title={doc.title.toLowerCase()}
              data-summary={doc.summary.toLowerCase()}
            >
              <div class="flex items-start justify-between">
                <h3 class="text-base font-semibold text-fxtxt group-hover:text-fxcyan transition-colors">
                  {doc.title}
                </h3>
                {doc.badge && (
                  <span class="rounded-full bg-fxcyan/10 px-2 py-0.5 text-[10px] font-medium text-fxcyan">
                    {doc.badge}
                  </span>
                )}
              </div>
              <p class="mt-2 text-sm text-fxtxt/50 line-clamp-2">{doc.summary}</p>
              <div class="mt-3 flex items-center text-xs text-fxcyan/70 opacity-0 group-hover:opacity-100 transition-opacity">
                Read more
                <svg class="ml-1 h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}

    <div class="mt-12 rounded-xl border border-fxcyan/10 bg-fxcyan/5 p-6 text-center">
      <h3 class="text-lg font-semibold text-fxtxt">Can't find what you're looking for?</h3>
      <p class="mt-2 text-sm text-fxtxt/50">
        Check out the <a href="/" class="text-fxcyan hover:underline">main site</a> or
        <a href="https://github.com/fxtune/fxtune" class="text-fxcyan hover:underline" target="_blank" rel="noopener noreferrer">GitHub repository</a>.
      </p>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('doc-search') as HTMLInputElement;
      const docCards = document.querySelectorAll('.doc-card');

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          const query = (e.target as HTMLInputElement).value.toLowerCase().trim();

          docCards.forEach((card) => {
            const el = card as HTMLElement;
            const title = el.dataset.title || '';
            const summary = el.dataset.summary || '';

            if (!query || title.includes(query) || summary.includes(query)) {
              el.style.display = '';
            } else {
              el.style.display = 'none';
            }
          });
        });
      }
    });
  </script>
</DocsLayout>
